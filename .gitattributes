# Normalise line endings in the repo, and make .editorconfig's `end_of_line
# = lf` actually enforced rather than aspirational.
* text=auto eol=lf

# The release archive is built with `git archive`, which ships every tracked
# file. These are the development harness: useful in the repo, pure noise
# inside a customer's Modules/QuietAutoClosed/ directory.
#
# Anything the module needs at runtime must NOT be listed here. The release
# workflow verifies the built archive still contains module.json, Providers/
# and Services/, so a mistake in this file fails the release instead of
# shipping a module FreeScout cannot load.
/.github            export-ignore
/Tests              export-ignore
/.editorconfig      export-ignore
/.codacy.yml        export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/phpunit.xml        export-ignore
/phpcs.xml          export-ignore
/composer.lock      export-ignore
/CONTRIBUTING.md    export-ignore
/CODE_OF_CONDUCT.md export-ignore
